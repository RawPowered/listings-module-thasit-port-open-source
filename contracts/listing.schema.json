{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Listing",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "owner_id",
    "title",
    "slug",
    "status",
    "visibility",
    "listing_type",
    "currency"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "category_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "slug": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string"
    },
    "listing_type": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "pending",
        "published",
        "archived"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "unlisted",
        "private"
      ]
    },
    "price_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "location_label": {
      "type": "string"
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "attributes": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}